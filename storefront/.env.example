# URL base del ERP (el canal publico vive en /storefront/... SIN prefijo /api).
ERP_API_URL=http://localhost:3001

# Clave del canal publico del ERP. SOLO SERVIDOR: nunca debe exponerse con el
# prefijo NEXT_PUBLIC_ ni llegar al bundle del navegador (decision D10).
# Una clave = una empresa: se crea con
#   npm run storefront:key -- --tenant <slug|id> --origins https://<dominio>
STOREFRONT_API_KEY=tienda-dev-key-cambiar

# Ciudad por defecto cuando el cliente todavia no eligio (cookie storefront_city).
STOREFRONT_CITY=SCZ

# Tope de espera de cada peticion al ERP, en milisegundos (opcional).
ERP_TIMEOUT_MS=8000

# URL publica de la tienda: se usa para canonicos, Open Graph, sitemap y JSON-LD.
# OBLIGATORIA en produccion (por defecto http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identidad de la empresa en la tienda (opcional): cabecera, pie, <title>, Open
# Graph y JSON-LD. Sin estas variables la tienda se llama «Tienda ERP» y usa la
# descripcion por defecto; en una tienda publicada conviene definirlas.
# NEXT_PUBLIC_SITE_NAME=Tienda A
# NEXT_PUBLIC_SITE_DESCRIPTION=Catalogo de Tienda A con entrega en Bolivia.

# Hosts ajenos de las FOTOS REALES de esta empresa, separados por comas (opcional).
# `next/image` solo optimiza imagenes de hosts declarados; los marcadores de
# posicion del seed (picsum.photos) se conservan siempre.
# IMAGE_REMOTE_HOSTS=cdn.tienda-a.com
