{
  "name": "erp-storefront",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda publica (storefront) del ERP: Next.js 14 App Router + TypeScript + Tailwind + Zustand. Consume el canal publico /storefront/... del ERP solo desde el servidor.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "sync:tokens:check": "node scripts/sync-tokens.mjs --check",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "sync:fonts:check": "node scripts/sync-fonts.mjs --check",
    "e2e": "playwright test",
    "e2e:visual": "playwright test -c playwright.visual.config.ts e2e/visual/store-visual.spec.ts",
    "e2e:visual:update": "playwright test -c playwright.visual.config.ts e2e/visual/store-visual.spec.ts --update-snapshots",
    "e2e:a11y": "playwright test -c playwright.visual.config.ts e2e/visual/store-a11y.spec.ts",
    "e2e:perf": "playwright test -c playwright.visual.config.ts e2e/visual/store-perf.spec.ts",
    "audit:contrast": "node scripts/audit-contrast.mjs"
  },
  "dependencies": {
    "next": "14.2.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "sharp": "0.33.5",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "axe-core": "4.13.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.32",
    "postcss": "8.4.47",
    "sass": "1.79.4",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
