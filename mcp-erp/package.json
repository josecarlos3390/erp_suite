{
  "name": "erp-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server (read-only) para el ERP de erp_suite: expone consultas de negocio y la documentación canónica del proyecto a cualquier cliente MCP.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "erp-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/__tests__/*.test.js\"",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "validate:overlay": "node scripts/validate-overlay.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "js-yaml": "^4.3.2",
    "typescript": "~5.7.3"
  }
}
